{
  "name": "@brainless-chef/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "predev": "corepack pnpm --filter @brainless-chef/database... build",
    "dev": "tsx watch src/index.ts",
    "premigrate": "corepack pnpm --filter @brainless-chef/database... build",
    "migrate": "tsx src/migrate.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@brainless-chef/database": "workspace:*",
    "@google-cloud/run": "^4.1.0",
    "express": "^5.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
