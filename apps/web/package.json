{
  "name": "@brainless-chef/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.server.json && tsc --noEmit && vite build",
    "dev": "vite",
    "dev:api": "node --env-file=.env --import tsx api/server.ts",
    "start": "node dist-server/server.js",
    "test": "vitest run test-unit",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.server.json"
  },
  "dependencies": {
    "@brainless-chef/database": "workspace:*",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "fast-jwt": "^6.2.4",
    "mailtrap": "^4.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}