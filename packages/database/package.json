    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "firestore-database": "^0.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
