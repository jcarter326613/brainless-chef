{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web: Debug",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web",
      "preLaunchTask": "Dev: All"
    },
    {
      "name": "Worker: Debug Recipe Prompt Experiment",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/worker/test-integration/scripts/chatgpt-recipe-experiment.ts",
      "cwd": "${workspaceFolder}/apps/worker",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
